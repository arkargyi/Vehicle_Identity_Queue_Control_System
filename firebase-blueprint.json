{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and role information",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "security", "operator", "viewer"] },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Truck": {
      "title": "Truck",
      "description": "Registered truck information",
      "type": "object",
      "properties": {
        "plate_number": { "type": "string" },
        "driver_name": { "type": "string" },
        "company": { "type": "string" },
        "vehicle_type": { "type": "string" },
        "cane_type": { "type": "string" },
        "is_blacklisted": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["plate_number", "driver_name", "company", "vehicle_type", "cane_type"]
    },
    "Gate": {
      "title": "Gate",
      "description": "Gate definitions",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["entry", "loading", "exit"] }
      },
      "required": ["name", "type"]
    },
    "Queue": {
      "title": "Queue",
      "description": "Queue entry for a truck",
      "type": "object",
      "properties": {
        "truck_id": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting", "called", "processing", "completed"] },
        "priority": { "type": "string", "enum": ["normal", "high"] },
        "gate_id": { "type": "string" },
        "entry_time": { "type": "string", "format": "date-time" },
        "call_time": { "type": "string", "format": "date-time" },
        "process_time": { "type": "string", "format": "date-time" },
        "exit_time": { "type": "string", "format": "date-time" }
      },
      "required": ["truck_id", "status", "priority", "entry_time"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Audit log for actions",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "action", "timestamp"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Application settings",
      "type": "object",
      "properties": {
        "cane_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "priority_rules": {
          "type": "object",
          "properties": {
            "high_priority_types": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Users collection"
    },
    "/trucks/{truckId}": {
      "schema": { "$ref": "#/entities/Truck" },
      "description": "Registered trucks"
    },
    "/gates/{gateId}": {
      "schema": { "$ref": "#/entities/Gate" },
      "description": "Gates"
    },
    "/queues/{queueId}": {
      "schema": { "$ref": "#/entities/Queue" },
      "description": "Truck queues"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit logs"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "App settings (e.g., settingId='config')"
    }
  }
}
